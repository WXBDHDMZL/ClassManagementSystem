# 混淆符号表（仅本机调试栈用，不入库）
/debug_info/

# 安装包产物（二进制，不入库）
/installer/output/

# Windows/macOS/Linux 生成目录
/windows/flutter/ephemeral/
/linux/flutter/ephemeral/
/macos/Flutter/ephemeral/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

tmp_*.py
__pycache__/

# 临时截图 / 本地调试残留（不参与构建与文档引用）
/shot_*.png
/*.tmp
/*.bak

# 网页版数据迁移的真实产物（含真实学生姓名，一律不入库）
/网页版数据迁移/迁移输出/
/网页版数据迁移/试跑/
/网页版数据迁移/*.json
!/网页版数据迁移/示例数据/*.json
!/网页版数据迁移/示例输出/*.json

# Agent 工作目录（会话/临时产物，不入库 —— 代码审查报告 L5）
/.workbuddy/

# 运行时数据、备份与日志：全局不忽略不得（报告 L5 补全为全局规则）
*.enc
*.bak
*.tmp
操作日志*.txt

# 说明：更新/ 目录是有意的发布变更记录（有审计价值），请勿添加忽略规则。

# 面向用户/同学的汇总更新说明：单独交付，默认不入库
/更新说明*.md
# 面向他人的说明文档放项目根目录，不进版本库；更新/ 只放每版更新内容
/*_面向同学.*
/*面向同学*.*
